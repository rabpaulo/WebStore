generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  ADMIN
  SELLER
}

enum OrderStatus {
  PENDING
  PAID
  PREPARING
  SHIPPED
  DELIVERED
  CANCELLED
}

enum InventoryMovementType {
  IN
  OUT
  ADJUSTMENT
}

model User {
  id           String              @id @default(uuid()) @db.Uuid
  name         String              @db.VarChar(100)
  email        String              @unique @db.VarChar(254)
  passwordHash String
  role         Role                @default(SELLER)
  createdAt    DateTime            @default(now()) @db.Timestamptz(3)
  updatedAt    DateTime            @updatedAt @db.Timestamptz(3)
  orders       Order[]
  movements    InventoryMovement[]
}

model Category {
  id        String    @id @default(uuid()) @db.Uuid
  name      String    @unique @db.VarChar(80)
  createdAt DateTime  @default(now()) @db.Timestamptz(3)
  updatedAt DateTime  @updatedAt @db.Timestamptz(3)
  products  Product[]
}

model Product {
  id          String           @id @default(uuid()) @db.Uuid
  name        String           @db.VarChar(150)
  description String           @default("") @db.VarChar(2000)
  categoryId  String           @db.Uuid
  active      Boolean          @default(true)
  createdAt   DateTime         @default(now()) @db.Timestamptz(3)
  updatedAt   DateTime         @updatedAt @db.Timestamptz(3)
  category    Category         @relation(fields: [categoryId], references: [id], onDelete: Restrict)
  variants    ProductVariant[]

  @@index([categoryId, active])
  @@index([name])
}

model ProductVariant {
  id           String              @id @default(uuid()) @db.Uuid
  productId    String              @db.Uuid
  sku          String              @unique @db.VarChar(80)
  color        String              @db.VarChar(50)
  size         String              @db.VarChar(20)
  price        Decimal             @db.Decimal(12, 2)
  currentStock Int                 @default(0)
  minimumStock Int                 @default(0)
  createdAt    DateTime            @default(now()) @db.Timestamptz(3)
  updatedAt    DateTime            @updatedAt @db.Timestamptz(3)
  product      Product             @relation(fields: [productId], references: [id], onDelete: Restrict)
  orderItems   OrderItem[]
  movements    InventoryMovement[]

  @@unique([productId, color, size])
  @@index([currentStock])
}

model Customer {
  id        String   @id @default(uuid()) @db.Uuid
  name      String   @db.VarChar(100)
  email     String?  @db.VarChar(254)
  phone     String?  @db.VarChar(30)
  createdAt DateTime @default(now()) @db.Timestamptz(3)
  updatedAt DateTime @updatedAt @db.Timestamptz(3)
  orders    Order[]

  @@index([name])
}

model Order {
  id          String              @id @default(uuid()) @db.Uuid
  number      Int                 @unique @default(autoincrement())
  customerId  String?             @db.Uuid
  status      OrderStatus         @default(PENDING)
  total       Decimal             @db.Decimal(12, 2)
  createdById String              @db.Uuid
  createdAt   DateTime            @default(now()) @db.Timestamptz(3)
  updatedAt   DateTime            @updatedAt @db.Timestamptz(3)
  paidAt      DateTime?           @db.Timestamptz(3)
  customer    Customer?           @relation(fields: [customerId], references: [id], onDelete: Restrict)
  createdBy   User                @relation(fields: [createdById], references: [id], onDelete: Restrict)
  items       OrderItem[]
  movements   InventoryMovement[]

  @@index([createdAt])
  @@index([status, paidAt])
  @@index([customerId])
  @@index([createdById])
}

model OrderItem {
  id               String         @id @default(uuid()) @db.Uuid
  orderId          String         @db.Uuid
  productVariantId String         @db.Uuid
  quantity         Int
  unitPrice        Decimal        @db.Decimal(12, 2)
  subtotal         Decimal        @db.Decimal(12, 2)
  order            Order          @relation(fields: [orderId], references: [id], onDelete: Restrict)
  productVariant   ProductVariant @relation(fields: [productVariantId], references: [id], onDelete: Restrict)

  @@unique([orderId, productVariantId])
  @@index([productVariantId])
}

model InventoryMovement {
  id               String                @id @default(uuid()) @db.Uuid
  productVariantId String                @db.Uuid
  type             InventoryMovementType
  quantity         Int
  previousStock    Int
  resultingStock   Int
  reason           String                @db.VarChar(500)
  orderId          String?               @db.Uuid
  createdById      String                @db.Uuid
  createdAt        DateTime              @default(now()) @db.Timestamptz(3)
  productVariant   ProductVariant        @relation(fields: [productVariantId], references: [id], onDelete: Restrict)
  order            Order?                @relation(fields: [orderId], references: [id], onDelete: Restrict)
  createdBy        User                  @relation(fields: [createdById], references: [id], onDelete: Restrict)

  @@index([productVariantId, createdAt])
  @@index([type, createdAt])
  @@index([orderId])
  @@index([createdById])
  @@index([createdAt])
}
